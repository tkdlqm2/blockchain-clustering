# .env 로 복사한 뒤 값을 채운다. 실제 시크릿은 절대 커밋하지 않는다.

# --- PostgreSQL ---
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=changeme
DB_NAME=clustering_db
DB_APP_USER=clustering_app
DB_APP_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=55432

# --- Kafka ---
KAFKA_PORT=9092
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_BALANCE_DELTA=balance-deltas
KAFKA_CONSUMER_GROUP_ID=clustering-consumer
KAFKA_CONSUMER_FLUSH_INTERVAL=10s

# --- App ---
APP_ENV=dev
APP_PORT=8080
LOG_LEVEL=debug

# --- Label maintenance (docs/03 §8) ---
LABEL_MAINTENANCE_INTERVAL=24h
LABEL_MAINTENANCE_STALE_TTL=720h
LABEL_MAINTENANCE_DECAY_FACTOR=0.5
