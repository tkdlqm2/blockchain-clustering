# .env로 복사한 뒤 값을 채운다. 실제 시크릿은 절대 커밋하지 않는다.
# 이 파일은 이 디렉토리의 docker-compose.yml(cluster-postgres/indexer-postgres/kafka/kafka-ui) 전용.

# --- blockchain_cluster: PostgreSQL ---
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=changeme
DB_NAME=clustering_db
DB_APP_USER=clustering_app
DB_APP_PASSWORD=changeme
DB_PORT=55432

# --- blockchain-indexer: PostgreSQL ---
POSTGRES_DB=blockchain_indexer
POSTGRES_SUPERUSER_PASSWORD=changeme
POSTGRES_APP_USER=indexer_app
POSTGRES_APP_PASSWORD=changeme
POSTGRES_PORT=5433

# --- 공유 Kafka ---
KAFKA_PORT=9092
