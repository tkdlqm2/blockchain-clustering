# .env로 복사한 뒤 실제 값을 채우세요. 이 파일은 placeholder만 담고 git에 커밋됩니다.

# PostgreSQL
POSTGRES_DB=blockchain_indexer
POSTGRES_SUPERUSER_PASSWORD=changeme
POSTGRES_APP_USER=indexer_app
POSTGRES_APP_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432 # 로컬에 이미 Postgres(Postgres.app 등)가 5432를 쓰고 있으면 5433 등으로 변경

# Kafka (로컬은 평문, docs/06 §7)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=balance-deltas

# Prometheus /metrics
METRICS_LISTEN_ADDR=:9100

# 서드파티 RPC 제공자 (Infura/Alchemy/QuickNode 등)
ETH_MAINNET_RPC_URL=
BTC_TESTNET_RPC_URL=
